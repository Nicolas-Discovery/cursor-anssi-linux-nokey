---
# Example secrets file - encrypt with `ansible-vault encrypt inventory/secrets.vault.yml`
# and pass it on the command line via `-e @inventory/secrets.vault.yml`.

# yescrypt hash, generated by:
#   mkpasswd -m yescrypt -s 65536
ansadmin_password_hash: "$y$j9T$..."

# CrowdSec console enrolment token (https://app.crowdsec.net).
crowdsec_enroll_token: "cscli_enroll_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# Azure Storage ACCOUNT KEY used by the SSH firewall allowlist updater
# (/usr/local/sbin/anssi-ssh-allowlist-update). Written to
# nftables.ssh_restriction.azure.key_file (mode 0600). Leave empty to use a SAS
# token (nftables.ssh_restriction.azure.sas_token) or anonymous access instead.
azure_ssh_allowlist_key: "base64accountkey=="

# Loki HTTP basic auth password.
loki_basic_auth_password: "change-me"

# Wazuh agent enrolment password (set the same on the manager's authd).
wazuh_enrollment_password: "change-me"
