# Managed by Ansible (nftables role) - static IP whitelists & blacklists.
# These sets are merged in the master ruleset by `include "/etc/nftables.d/*.conf"`.

set ip_whitelist_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if nftables.ip_whitelist_v4 %}
    elements = {
{% for cidr in nftables.ip_whitelist_v4 %}
        {{ cidr }}{{ "," if not loop.last else "" }}
{% endfor %}
    }
{% endif %}
}

