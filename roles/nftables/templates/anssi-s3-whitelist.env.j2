# Managed by Ansible (nftables role) - environment file consumed ONLY by the
# anssi-s3-whitelist-update.service systemd unit. File mode is 0600.
#
# Prefer instance metadata / IAM roles when possible (leave this file empty
# except for AWS_DEFAULT_REGION). Provide static keys via Ansible Vault if
# you cannot use a role.
{% if nftables.s3_whitelist.region | default('') | length > 0 %}
AWS_DEFAULT_REGION={{ nftables.s3_whitelist.region }}
{% endif %}
{% if nftables.s3_whitelist.access_key_id | default('') | length > 0 %}
AWS_ACCESS_KEY_ID={{ nftables.s3_whitelist.access_key_id }}
{% endif %}
{% if nftables.s3_whitelist.secret_access_key | default('') | length > 0 %}
AWS_SECRET_ACCESS_KEY={{ nftables.s3_whitelist.secret_access_key }}
{% endif %}
{% if nftables.s3_whitelist.session_token | default('') | length > 0 %}
AWS_SESSION_TOKEN={{ nftables.s3_whitelist.session_token }}
{% endif %}
{% for k, v in (nftables.s3_whitelist.extra_env | default({})).items() %}
{{ k }}={{ v }}
{% endfor %}
