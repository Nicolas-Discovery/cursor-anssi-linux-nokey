# Managed by Ansible (nftables role) - SSH allowlist seed.
#
# Defines the nftables sets `ssh_allow_v4` / `ssh_allow_v6` consumed by the
# master ruleset to gate the SSH port. This file is the INITIAL seed written
# from nftables.ssh_restriction.static_allow_*; it is subsequently REGENERATED
# in place by /usr/local/sbin/anssi-ssh-allowlist-update, which merges these
# static entries with the IP list fetched from the Azure Blob Storage bucket.

set ssh_allow_v4 {
    type ipv4_addr
    flags interval
    auto-merge
{% if nftables.ssh_restriction.static_allow_v4 %}
    elements = {
{% for cidr in nftables.ssh_restriction.static_allow_v4 %}
        {{ cidr }}{{ "," if not loop.last else "" }}
{% endfor %}
    }
{% endif %}
}

set ssh_allow_v6 {
    type ipv6_addr
    flags interval
    auto-merge
{% if nftables.ssh_restriction.static_allow_v6 %}
    elements = {
{% for cidr in nftables.ssh_restriction.static_allow_v6 %}
        {{ cidr }}{{ "," if not loop.last else "" }}
{% endfor %}
    }
{% endif %}
}
