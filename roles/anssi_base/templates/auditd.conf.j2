# Managed by Ansible (anssi_base) - ANSSI BP-028 R72
log_file = /var/log/audit/audit.log
log_format = ENRICHED
log_group = adm
priority_boost = 4
flush = {{ anssi_base.auditd.flush }}
freq = {{ anssi_base.auditd.freq }}
max_log_file = {{ anssi_base.auditd.max_log_file }}
num_logs = {{ anssi_base.auditd.num_logs }}
max_log_file_action = ROTATE
space_left = {{ anssi_base.auditd.space_left }}
space_left_action = {{ anssi_base.auditd.space_left_action }}
admin_space_left = {{ anssi_base.auditd.admin_space_left }}
admin_space_left_action = {{ anssi_base.auditd.disk_full_action }}
disk_full_action = {{ anssi_base.auditd.disk_full_action }}
disk_error_action = {{ anssi_base.auditd.disk_error_action }}
action_mail_acct = {{ anssi_base.auditd.action_mail_acct }}
name_format = {{ anssi_base.auditd.name_format }}
verify_email = no
use_libwrap = no
write_logs = yes
