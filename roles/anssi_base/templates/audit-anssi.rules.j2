# Managed by Ansible (anssi_base) - ANSSI BP-028 R72 (excerpt)
-D
-b 8192
-f 1
--backlog_wait_time 60000

# --- Identity / accounts -----------------------------------------------------
-w /etc/passwd          -p wa -k identity
-w /etc/shadow          -p wa -k identity
-w /etc/group           -p wa -k identity
-w /etc/gshadow         -p wa -k identity
-w /etc/security/opasswd -p wa -k identity
-w /etc/sudoers         -p wa -k privilege
-w /etc/sudoers.d/      -p wa -k privilege

# --- Time --------------------------------------------------------------------
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time-change
-a always,exit -F arch=b32 -S adjtimex,settimeofday,clock_settime -k time-change
-w /etc/localtime -p wa -k time-change

# --- Privileged commands -----------------------------------------------------
-a always,exit -F path=/usr/bin/sudo            -F perm=x -F auid>=1000 -F auid!=4294967295 -k actions
-a always,exit -F path=/usr/bin/su              -F perm=x -F auid>=1000 -F auid!=4294967295 -k actions
-a always,exit -F path=/usr/bin/passwd          -F perm=x -F auid>=1000 -F auid!=4294967295 -k actions
-a always,exit -F path=/usr/bin/newgrp          -F perm=x -F auid>=1000 -F auid!=4294967295 -k actions
-a always,exit -F path=/usr/bin/chsh            -F perm=x -F auid>=1000 -F auid!=4294967295 -k actions
-a always,exit -F path=/usr/sbin/usermod        -F perm=x -F auid>=1000 -F auid!=4294967295 -k actions
-a always,exit -F path=/usr/sbin/visudo         -F perm=x -F auid>=1000 -F auid!=4294967295 -k actions

# --- Module / kernel ---------------------------------------------------------
-w /sbin/insmod   -p x -k modules
-w /sbin/rmmod    -p x -k modules
-w /sbin/modprobe -p x -k modules
-a always,exit -F arch=b64 -S init_module,delete_module,finit_module -k modules

# --- Network -----------------------------------------------------------------
-a always,exit -F arch=b64 -S sethostname,setdomainname -k system-locale
-w /etc/issue       -p wa -k system-locale
-w /etc/issue.net   -p wa -k system-locale
-w /etc/hosts       -p wa -k system-locale
-w /etc/network/    -p wa -k system-locale

# --- Login / logout ----------------------------------------------------------
-w /var/log/faillog -p wa -k logins
-w /var/log/lastlog -p wa -k logins
-w /var/log/tallylog -p wa -k logins
-w /var/run/utmp    -p wa -k session
-w /var/log/wtmp    -p wa -k session
-w /var/log/btmp    -p wa -k session

# --- Mounts ------------------------------------------------------------------
-a always,exit -F arch=b64 -S mount,umount2 -F auid>=1000 -F auid!=4294967295 -k mounts

# --- Privileged setuid/setgid binaries detection -----------------------------
-a always,exit -F arch=b64 -S execve -C euid!=uid -F auid!=4294967295 -k privileged

# --- File permissions / DAC --------------------------------------------------
-a always,exit -F arch=b64 -S chmod,fchmod,fchmodat -F auid>=1000 -F auid!=4294967295 -k perm_mod
-a always,exit -F arch=b64 -S chown,fchown,lchown,fchownat -F auid>=1000 -F auid!=4294967295 -k perm_mod
-a always,exit -F arch=b64 -S setxattr,lsetxattr,fsetxattr,removexattr,lremovexattr,fremovexattr -F auid>=1000 -F auid!=4294967295 -k perm_mod

# --- Make rules immutable (must be last) -------------------------------------
-e 2
